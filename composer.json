{
    "name": "voila_cms/crudbooster",
    "description": "CRUDBooster Is CRUD Generator Based On Laravel Easy To Make An Advanced Backend",
    "type": "library",
    "license": "MIT",
    "keywords":[
        "laravel",
        "admin-panel",
        "backend",
        "crud-generator",
        "crudbooster",
        "crud",
        "generator"
    ],
    "authors": [
        {
            "name": "Ferry",
            "email": "ferry@crocodic.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php":"^8.1.13",
        "barryvdh/laravel-dompdf": "^1.0|^2.0",
        "doctrine/inflector": "^2.0",
        "doctrine/dbal": "^3.0",
        "nesbot/carbon": "^2.31",
        "doctrine/common": "^3.0",
        "carbonphp/carbon-doctrine-types": "^2.0",
        "maatwebsite/excel": "^3.1",
        "intervention/imagecache":"^2.6",
        "laravel/framework": "^8.75|^9.0|^10.0",
        "intervention/image": "^2.7",
        "tecnickcom/tcpdf": "^6.6"
    },
    "autoload": {
        "psr-4": {
          "crocodicstudio\\crudbooster\\": "src/"
        }
      },
    "extra": {
        "laravel": {
            "providers": [
                "crocodicstudio\\crudbooster\\CRUDBoosterServiceProvider"
            ]
        }
    }
}
